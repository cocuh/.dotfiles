[global]
    monitor = 0
    follow = none
    width = 400
    height = (0, 300)
    notification_limit = 5
    origin = top-right
    offset = (0, 20)
    indicate_hidden = yes

    separator_height = 2
    padding = 8
    horizontal_padding = 8
    frame_width = 0
    frame_color = "#aaaaaa"
    separator_color = auto
    sort = yes
    idle_threshold = 120

    font = Ricty 12
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    max_icon_size = 64
    icon_theme = Adwaita
    enable_recursive_icon_lookup = true

    sticky_history = yes
    history_length = 20

    # rofi works on both X11 (awesome) and Wayland (Hyprland); dmenu is X11-only
    dmenu = rofi -dmenu -p dunst
    browser = xdg-open
    always_run_script = true
    verbosity = mesg

# Backgrounds carry alpha because the transparency option is X11-only.
[urgency_low]
    background = "#222222e6"
    foreground = "#888888"
    timeout = 10

[urgency_normal]
    background = "#285577e6"
    foreground = "#ffffff"
    timeout = 10

[urgency_critical]
    background = "#900000e6"
    foreground = "#ffffff"
    frame_color = "#ff0000"
    timeout = 0

# vim: ft=cfg
