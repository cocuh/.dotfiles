[global]
    monitor = 0
    follow = none
    width = 360
    height = (0, 300)
    notification_limit = 5
    origin = top-right
    offset = (8, 8)
    indicate_hidden = yes

    gap_size = 6
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    corner_radius = 0
    sort = yes
    idle_threshold = 120

    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    max_icon_size = 32
    icon_theme = Adwaita
    enable_recursive_icon_lookup = true

    sticky_history = yes
    history_length = 20

    always_run_script = true
    verbosity = mesg

# Backgrounds carry alpha because the transparency option is X11-only.
# Urgency is told apart by the frame color only; the background stays the same.
[urgency_low]
    background = "#1c1e24e6"
    foreground = "#888888"
    frame_color = "#3b3e47"
    timeout = 10

[urgency_normal]
    background = "#1c1e24e6"
    foreground = "#d8d8d8"
    frame_color = "#7aa2f7"
    timeout = 10

[urgency_critical]
    background = "#1c1e24e6"
    foreground = "#d8d8d8"
    frame_color = "#f7768e"
    timeout = 0

