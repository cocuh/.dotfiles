// The laptop panel is too narrow for long titles, so it gets its own lengths.
[
    {
        "include": ["~/.config/waybar/common.jsonc"],
        "output": "!eDP-1",
        "hyprland/window": { "max-length": 80 },
        "mpris": { "dynamic-len": 60 }
    },
    {
        "include": ["~/.config/waybar/common.jsonc"],
        "output": "eDP-1",
        "hyprland/window": { "max-length": 30 },
        "mpris": { "dynamic-len": 25, "title-len": 25 }
    }
]
