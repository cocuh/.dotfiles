() {
  setopt local_options no_mark_dirs

  typeset -gU path
  # Nix profile first: hyprctl must match the Nix-built Hyprland, not the older
  # one in /usr/bin. No-op on machines without Nix.
  path=(~/.nix-profile/bin(N-/) $path)
  path+=(
    ~/bin(N-/)
    ~/.local/bin(N-/)
    ~/.cargo/bin(N-/)
    ~/.local/share/JetBrains/Toolbox/scripts(N-/)
  )

  if (( $+commands[nvim] )); then
    export EDITOR='nvim'
  elif (( $+commands[vim] )); then
    export EDITOR='vim'
  fi
}
