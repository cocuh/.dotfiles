# machine-local settings (credential helpers etc.) go in ~/.gitconfig, which is not tracked
[alias]
	st = status -sb
    watch-st = !watch --color git -c color.status=always st
	today = "!git log --since=midnight --author=\"$(git config user.name)\" --oneline"
	c = commit
    ll = log --all --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	# Deletes local branches already merged into origin's default branch.
	# Keeps the default branch and any branch checked out in a worktree.
	delete-merged-branches = "!f() { base=$(git rev-parse --abbrev-ref origin/HEAD) || return; git branch --merged \"$base\" --format='%(refname:short) %(worktreepath)' | awk -v keep=\"${base#origin/}\" '$2 == \"\" && $1 != keep { print $1 }' | xargs -r git branch -D; }; f"
[color]
	ui = auto
[user]
	name = cocuh
	email = cocuh@users.noreply.github.com

[github]
	user = cocuh
[core]
	autocrlf = input
	pager=less -q -R 
[merge]
	tool = vimdiff
#[push]
#	default = simple
[init]
	defaultBranch = main
[pull]
	rebase = false
[fetch]
	# Drops origin/* refs for branches deleted on GitHub.
	prune = true
